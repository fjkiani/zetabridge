from fastapi import APIRouter
from pydantic import BaseModel
from agents.query_agent import execute_nl_query
from lineage.marquez_client import emit_query_lineage
import re

router = APIRouter(prefix="/api/query")

class QueryRequest(BaseModel):
    question: str
    source: str = "duckdb"  # duckdb | snowflake | databricks | unified

@router.post("")
async def run_query(req: QueryRequest):
    result = execute_nl_query(req.question, req.source)
    if not result["error"]:
        tables = re.findall(r'FROM\s+(\w+)', result["sql"], re.I)
        emit_query_lineage(
            job_name="copilot_query",
            sql=result["sql"],
            input_tables=tables,
            output_table=None,
            source=req.source
        )
    return result
