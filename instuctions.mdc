python
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from dotenv import load_dotenv
load_dotenv()

from routers import query, catalog, lineage, connectors, copilot
from catalog.gravitino_client import GravitinoClient

app = FastAPI(title="ZetaBridge API", version="1.0.0")

app.add_middleware(CORSMiddleware,
    allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])

app.include_router(query.router)
app.include_router(catalog.router)
app.include_router(lineage.router)
app.include_router(connectors.router)
app.include_router(copilot.router)

@app.on_event("startup")
async def startup():
    g = GravitinoClient()
    g.setup_metalake()
    g.register_snowflake_catalog()
    g.register_databricks_catalog()
    print("Gravitino catalogs registered")

@app.get("/health")
async def health():
    return {"status": "ok"}
