from databricks import sql
from databricks.sdk import WorkspaceClient
from config import cfg

class DatabricksConnector:
    def get_conn(self):
        return sql.connect(
            server_hostname=cfg.DATABRICKS_HOST,
            http_path=cfg.DATABRICKS_HTTP_PATH,
            access_token=cfg.DATABRICKS_TOKEN
        )

    def list_unity_catalog_tables(self) -> list[dict]:
        w = WorkspaceClient(
            host=cfg.DATABRICKS_HOST,
            token=cfg.DATABRICKS_TOKEN
        )
        tables = []
        for t in w.tables.list(
            catalog_name=cfg.DATABRICKS_CATALOG,
            schema_name=cfg.DATABRICKS_SCHEMA
        ):
            tables.append({
                "name": t.name,
                "catalog": t.catalog_name,
                "schema": t.schema_name,
                "type": str(t.table_type),
                "format": str(t.data_source_format)
            })
        return tables

    def get_schema(self, table: str) -> list[dict]:
        conn = self.get_conn()
        cur = conn.cursor()
        cur.execute(f"DESCRIBE TABLE {cfg.DATABRICKS_CATALOG}"
                    f".{cfg.DATABRICKS_SCHEMA}.{table}")
        cols = cur.fetchall()
        return [{"name": r[0], "type": r[1]} for r in cols]

    def run_query(self, sql_str: str) -> list[dict]:
        conn = self.get_conn()
        cur = conn.cursor()
        cur.execute(sql_str)
        cols = [d[0] for d in cur.description]
        return [dict(zip(cols, row)) for row in cur.fetchall()]

    def test_connection(self) -> bool:
        try:
            self.run_query("SELECT 1")
            return True
        except Exception:
            return False
