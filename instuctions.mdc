# backend/catalog/gravitino_client.py
import requests
from config import cfg

METALAKE = "zetabridge"
BASE = cfg.GRAVITINO_URL + "/api/metalakes"

class GravitinoClient:
    def setup_metalake(self):
        requests.post(BASE, json={
            "name": METALAKE,
            "comment": "ZetaBridge unified catalog",
            "properties": {}
        })

    def register_snowflake_catalog(self):
        requests.post(f"{BASE}/{METALAKE}/catalogs", json={
            "name": "snowflake",
            "type": "RELATIONAL",
            "provider": "jdbc",
            "comment": "Snowflake production warehouse",
            "properties": {
                "jdbc-driver": "net.snowflake.client.jdbc.SnowflakeDriver",
                "jdbc-url": f"jdbc:snowflake://{cfg.SNOWFLAKE_ACCOUNT}.snowflakecomputing.com",
                "jdbc-user": cfg.SNOWFLAKE_USER,
                "jdbc-password": cfg.SNOWFLAKE_PASSWORD
            }
        })

    def register_databricks_catalog(self):
        # Register Unity Catalog OSS as a catalog entry
        requests.post(f"{BASE}/{METALAKE}/catalogs", json={
            "name": "databricks",
            "type": "RELATIONAL",
            "provider": "jdbc",
            "comment": "Databricks Unity Catalog",
            "properties": {
                "jdbc-driver": "com.simba.spark.jdbc.Driver",
                "jdbc-url": f"jdbc:spark://{cfg.DATABRICKS_HOST}:443"
                            f"/default;transportMode=http;ssl=1;"
                            f"httpPath={cfg.DATABRICKS_HTTP_PATH}",
                "jdbc-user": "token",
                "jdbc-password": cfg.DATABRICKS_TOKEN
            }
        })

    def list_all_tables(self) -> list[dict]:
        catalogs = requests.get(
            f"{BASE}/{METALAKE}/catalogs"
        ).json().get("catalogs", [])
        tables = []
        for cat in catalogs:
            try:
                schemas = requests.get(
                    f"{BASE}/{METALAKE}/catalogs/{cat['name']}/schemas"
                ).json().get("schemas", [])
                for schema in schemas:
                    tbls = requests.get(
                        f"{BASE}/{METALAKE}/catalogs/{cat['name']}"
                        f"/schemas/{schema['name']}/tables"
                    ).json().get("tables", [])
                    for t in tbls:
                        t["catalog"] = cat["name"]
                        t["schema"] = schema["name"]
                        tables.append(t)
            except Exception:
                pass
        return tables
Phase 6 — Arctic NL→SQL Agent (the demo's centerpiece)
python
# backend/agents/query_agent.py
from huggingface_hub import InferenceClient
from connectors.snowflake_connector import SnowflakeConnector
from connectors.databricks_connector import DatabricksConnector
from connectors.duckdb_connector import DuckDBConnector
from catalog.gravitino_client import GravitinoClient
from config import cfg
import re

client = InferenceClient(
    model="Snowflake/Arctic-Text2SQL-R1.5",
    token=cfg.HF_API_TOKEN
)

def get_schema_context(source: str) -> str:
    """Pull live schema from whichever source is targeted."""
    if source == "snowflake":
        tables = SnowflakeConnector().list_tables()
    elif source == "databricks":
        tables = DatabricksConnector().list_unity_catalog_tables()
    elif source == "unified":
        tables = GravitinoClient().list_all_tables()
    else:
        tables = DuckDBConnector().list_tables()

    lines = []
    for t in tables[:30]:  # cap context window
        name = t.get("TABLE_NAME") or t.get("name", "unknown")
        lines.append(f"- {name}")
    return "Available tables:\n" + "\n".join(lines)

def nl_to_sql(question: str, source: str = "duckdb") -> dict:
    schema_ctx = get_schema_context(source)
    prompt = (
        f"You are a SQL expert. Given these tables:\n{schema_ctx}\n\n"
        f"Write a single SQL query to answer: {question}\n"
        f"SQL:"
    )
    raw = client.text_generation(
        prompt,
        max_new_tokens=300,
        temperature=0.1,
        stop_sequences=[";", "\n\n"]
    )
    sql = raw.strip().rstrip(";") + ";"
    return {"sql": sql, "source": source, "schema_context": schema_ctx}

def execute_nl_query(question: str, source: str = "duckdb") -> dict:
    result = nl_to_sql(question, source)
    sql = result["sql"]
    try:
        if source == "snowflake":
            rows = SnowflakeConnector().run_query(sql)
        elif source == "databricks":
            rows = DatabricksConnector().run_query(sql)
        else:
            rows = DuckDBConnector().run_query(sql)
        return {"sql": sql, "rows": rows, "source": source, "error": None}
    except Exception as e:
        return {"sql": sql, "rows": [], "source": source, "error": str(e)}
Phase 7 — Lineage: Emit on Every Query
python
# backend/lineage/marquez_client.py
import uuid
import requests
from datetime import datetime, timezone
from config import cfg

def emit_query_lineage(job_name: str, sql: str,
                        input_tables: list[str],
                        output_table: str | None,
                        source: str):
    run_id = str(uuid.uuid4())
    now = datetime.now(timezone.utc).isoformat()
    namespace = f"zetabridge.{source}"

    event = {
        "eventType": "COMPLETE",
        "eventTime": now,
        "run": {"runId": run_id},
        "job": {"namespace": namespace, "name": job_name},
        "inputs": [
            {"namespace": namespace, "name": t}
            for t in input_tables
        ],
        "outputs": (
            [{"namespace": namespace, "name": output_table}]
            if output_table else []
        ),
        "producer": "zetabridge/query-agent"
    }

    requests.post(
        cfg.MARQUEZ_URL + "/api/v1/lineage",
        json=event,
        timeout=5
    )

def get_lineage_graph(dataset: str, source: str) -> dict:
    namespace = f"zetabridge.{source}"
    resp = requests.get(
        f"{cfg.MARQUEZ_URL}/api/v1/lineage",
        params={"nodeId": f"dataset:{namespace}:{dataset}", "depth": 5}
    )
    return resp.json()
