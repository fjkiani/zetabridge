# ZetaBridge — Required Environment Variables
# Copy to .env and fill in values

# Postgres (Neon free tier: https://neon.tech)
DATABASE_URL=postgresql://user:pass@host/zetabridge

# HuggingFace Inference API (free: https://huggingface.co/settings/tokens)
HF_API_TOKEN=hf_your_token_here

# Optional: Override the Text2SQL model
# HF_MODEL_ID=Snowflake/Arctic-Text2SQL-R1-7B

# Server
PORT=8000
LOG_LEVEL=INFO
