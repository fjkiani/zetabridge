SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=PUBLIC

DATABRICKS_HOST=adb-xxxxx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxx
DATABRICKS_TOKEN=dapi_xxxxx
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default

HF_API_TOKEN=hf_xxxxx
HF_TEXT2SQL_MODEL=Snowflake/Arctic-Text2SQL-R1-7B

GRAVITINO_URL=http://localhost:8090
MARQUEZ_URL=http://localhost:5000

DUCKDB_PATH=./data/zetabridge.duckdb
DATABASE_URL=postgresql://user:pass@host:5432/zetabridge

# CRC IPD → Postgres on FastAPI lifespan (Render sets this to 1 in render.yaml)
CRC_IPD_SEED_ON_BOOT=0
# CRC_IPD_CSV_PATH=  # optional override; default backend/resources/crc_ipd/crc_ipd_harmonized_v3.csv

USE_LEGACY_STORE=1
LOG_LEVEL=INFO

# --- Federated Neo4j knowledge graph (Session 12 agent access layer) ---
# Server-side only. Consumer agents authenticate with ZETA_GRAPH_API_KEY,
# never with the Neo4j password.
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=xxxxx
# Scoped API key an external agent presents in the X-Zeta-Api-Key header.
# If unset, all /api/graph endpoints return 503 (closed by default).
ZETA_GRAPH_API_KEY=change-me-to-a-long-random-string

# --- Live source endpoints (Session 15) ---
# SERVER-SIDE ONLY. The backend uses these to connect to the three *source*
# systems and extract live. They are NEVER exposed to a calling agent — the
# agent authenticates with ZETA_GRAPH_API_KEY (above) and the backend does the
# extraction. Do NOT commit real values; set them in deploy secrets or a
# git-ignored env file, and rotate anything that leaks.
#
# A_MSK — Synapse personal access token (JWT, eyJ...)
SYNAPSE_AUTH_TOKEN=
# B_SAS — Project Data Sphere / SAS Viya CAS
SAS_CAS_HOST=mpmprodvdmml.ondemand.sas.com
SAS_CAS_PORT=443
SAS_CAS_PROTOCOL=https
# either a bearer token OR user+password
SAS_CAS_TOKEN=
SAS_CAS_USER=
SAS_CAS_PASSWORD=
# optional CA bundle path if the CAS TLS cert is not in the system store
SAS_CAS_CADATA=
# C_EGA — European Genome-phenome Archive (controlled access)
EGA_USERNAME=
EGA_PASSWORD=
EGA_CREDENTIALS_FILE=
EGA_DEFAULT_DATASET=EGAD00001011049
# D_ARGO — ICGC ARGO / Overture SONG+SCORE (DACO controlled-access genomics).
# SERVER-SIDE ONLY, never sent to callers. The DACO-approved token is the sole
# credential; the backend uses it to mint short-lived pre-signed download URLs.
# Heavy BAM/CRAM bytes stream DIRECTLY from ICGC_ARGO_OBJECT_HOST to the
# caller/worker — they are never proxied through this backend. Leave unset =>
# ARGO reports "unconfigured" (registry listing may still work; controlled
# download resolution returns unreachable:auth).
ICGC_ARGO_TOKEN=
ICGC_ARGO_API_BASE=https://api.platform.icgc-argo.org
ICGC_ARGO_OBJECT_HOST=object.genomeinformatics.org

# Frontend (artifacts/zetabridge) — required for API calls in dev/build when not using same-origin proxy
VITE_API_BASE=http://localhost:8000
