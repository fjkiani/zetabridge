{
  "mcpServers": {
    "zeta-graph": {
      "command": "python3",
      "args": ["-m", "mcp_server.zeta_graph_mcp"],
      "cwd": "/absolute/path/to/zetabridge/backend",
      "env": {
        "NEO4J_URI": "neo4j+s://<host>.databases.neo4j.io",
        "NEO4J_USER": "<neo4j-user>",
        "NEO4J_PASSWORD": "<neo4j-password>"
      }
    }
  }
}
